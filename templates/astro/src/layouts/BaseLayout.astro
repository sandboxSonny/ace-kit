---
import AcePreviewRefresh from "@sandboxsonny/ace-kit/astro/AcePreviewRefresh.astro";
import AceSeo from "@sandboxsonny/ace-kit/astro/AceSeo.astro";
import type { AceEntry } from "@sandboxsonny/ace-kit";
import SiteFooter from "~/components/SiteFooter.astro";
import SiteHeader from "~/components/SiteHeader.astro";
import "~/styles/global.css";

type Props = {
  /** The entry the page shows: its SEO title and description fill the page's search and sharing tags. */
  entry?: AceEntry;
  /** Used when there is no entry (a notice page), and when an entry has no title of its own. */
  title: string;
  description?: string;
  /** True when the page is showing a draft inside the CMS's preview frame. */
  preview?: boolean;
};

const { entry, title, description = "A simple example site for testing CMS Ace.", preview = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Title, description, canonical address, robots and sharing tags. A draft shown in preview is kept out of search. */}
    <AceSeo entry={entry} {title} {description} siteName="Example Site" noindex={preview} />
  </head>
  <body>
    <SiteHeader />
    <main>
      <slot />
    </main>
    <SiteFooter />
    <AcePreviewRefresh />
  </body>
</html>
